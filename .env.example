# Copy to .env.local. Never commit credentials. Use separate projects for previews.
APP_URL=http://localhost:3000
APP_ENV=development
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=
SUPABASE_PROJECT_REF=
PRODUCTION_SUPABASE_PROJECT_REF=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_NEWSLETTER_SEGMENT_ID=
RESEND_FROM=GitHub Signals <newsletter@mail.githubsignals.com>
REPLY_TO_EMAIL=hello@githubsignals.com
EMAIL_ENABLED=false
# Preview email is restricted to these exact addresses; broadcasts are production-only.
TEST_RECIPIENTS=
CRON_SECRET=
TOKEN_SECRET=
RATE_LIMIT_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
BUSINESS_NAME=
BUSINESS_POSTAL_ADDRESS=
CONTACT_EMAIL=
# Enable only after provider setup and real inbox tests are complete.
SIGNUPS_ENABLED=false

# Operator-only backup/migration settings. Do not add DATABASE_URL or this key to browser variables.
DATABASE_CA_FILE=
BACKUP_ENCRYPTION_KEY=
